{
  "name": "retailflow-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:apk": "npx --yes eas-cli build -p android --profile preview",
    "build:apk:local": "npx --yes eas-cli build -p android --profile preview --local",
    "eas:login": "npx --yes eas-cli login",
    "build:web": "expo export -p web",
    "fix-deps": "expo install --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aramir/react-native-barcode": "^1.1.2",
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.9",
    "expo-audio": "~1.0.0",
    "expo-camera": "~17.0.0",
    "expo-constants": "~18.0.9",
    "expo-file-system": "~19.0.0",
    "expo-image": "~3.0.0",
    "expo-image-picker": "~17.0.0",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.8",
    "expo-print": "~15.0.0",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.7",
    "expo-sharing": "~14.0.0",
    "expo-status-bar": "~3.0.0",
    "lucide-react-native": "^0.511.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.0"
  }
}
